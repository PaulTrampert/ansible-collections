---
# Written as data rather than stringData, which the API server converts and
# never returns, so that an unchanged Secret compares equal on the next run.
apiVersion: v1
kind: Secret
metadata:
  name: {{ cert_manager_dns01_secret }}
  namespace: {{ cert_manager_namespace }}
type: Opaque
data:
{% for key, value in cert_manager_dns01_credential.items() %}
  {{ key }}: {{ value | string | b64encode }}
{% endfor %}
