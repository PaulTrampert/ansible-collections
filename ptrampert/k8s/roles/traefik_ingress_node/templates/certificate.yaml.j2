---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ item.secret_name }}
  namespace: {{ traefik_ingress_node_namespace }}
spec:
  secretName: {{ item.secret_name }}
  dnsNames: {{ item.dns_names | to_json }}
  issuerRef:
    kind: ClusterIssuer
    name: {{ traefik_ingress_node_issuer }}
