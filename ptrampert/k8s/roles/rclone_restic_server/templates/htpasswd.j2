{# The salt comes from the namespace and the user rather than at random, so an
   unchanged password hashes the same on every run. #}
{% for user in rclone_restic_server_users %}
{{ user.name }}:{{ user.password | password_hash('bcrypt',
     salt=((rclone_restic_server_namespace ~ '/' ~ user.name) | hash('sha256'))[:22],
     rounds=rclone_restic_server_bcrypt_cost) }}
{% endfor %}
