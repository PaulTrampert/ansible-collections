---
# Written as data rather than stringData, which the API server converts and
# never returns, so that an unchanged Secret compares equal on the next run.
apiVersion: v1
kind: Secret
metadata:
  name: {{ rclone_restic_server_name }}-seed
  namespace: {{ rclone_restic_server_namespace }}
type: Opaque
data:
  rclone.conf: {{ rclone_restic_server_rclone_conf | b64encode }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ rclone_restic_server_name }}-htpasswd
  namespace: {{ rclone_restic_server_namespace }}
type: Opaque
data:
  htpasswd: {{ rclone_restic_server_htpasswd | b64encode }}
