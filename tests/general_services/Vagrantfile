# Test VMs for ptrampert.general_services: two load balancers that share a
# floating VIP (192.168.56.30, see inventory/lb.yml).

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 1
    vb.memory = 1024
    vb.linked_clone = true
  end

  (1..2).each do |i|
    config.vm.define "lb#{i}" do |node|
      node.vm.hostname = "lb#{i}"
      node.vm.network "private_network", ip: "192.168.56.#{19 + i}"
    end
  end
end
