# Test VMs for ptrampert.k8s.
#
# K8S_TOPOLOGY picks the shape of the cluster; each has a matching inventory
# under inventory/. Set it for *every* vagrant command, including destroy, and
# destroy one topology before bringing up another: the VMs share names.
#
#   single (default)  one control-plane node that also runs workloads
#   multi             one control-plane node, two workers, and an NFS server
#   stacked-ha        three control-plane nodes load balancing for themselves
#   external-lb       three control-plane nodes behind a separate HAProxy host

TOPOLOGIES = {
  "single"      => {control_planes: 1, workers: 0, load_balancer: false, nfs_server: false},
  "multi"       => {control_planes: 1, workers: 2, load_balancer: false, nfs_server: true},
  "stacked-ha"  => {control_planes: 3, workers: 0, load_balancer: false, nfs_server: false},
  "external-lb" => {control_planes: 3, workers: 1, load_balancer: true, nfs_server: false},
}

TOPOLOGY = ENV.fetch("K8S_TOPOLOGY", "single")
SHAPE = TOPOLOGIES.fetch(TOPOLOGY) do
  abort "K8S_TOPOLOGY must be one of #{TOPOLOGIES.keys.join(", ")}, got '#{TOPOLOGY}'"
end

# The stacked topologies float 192.168.56.9 across the control-plane nodes, so
# no VM may have it.
SUBNET = "192.168.56"
LOAD_BALANCER_HOST = 8
FIRST_CONTROL_PLANE_HOST = 10
FIRST_WORKER_HOST = 21
NFS_SERVER_HOST = 30

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 2
    vb.memory = 4096
    vb.linked_clone = true
  end

  if SHAPE[:load_balancer]
    config.vm.define "lb1" do |node|
      node.vm.hostname = "lb1"
      node.vm.network "private_network", ip: "#{SUBNET}.#{LOAD_BALANCER_HOST}"

      # It only proxies TCP; it runs no part of the cluster.
      node.vm.provider "virtualbox" do |vb|
        vb.cpus = 1
        vb.memory = 1024
      end
    end
  end

  (0...SHAPE[:control_planes]).each do |i|
    config.vm.define "cp#{i + 1}" do |node|
      node.vm.hostname = "cp#{i + 1}"
      node.vm.network "private_network", ip: "#{SUBNET}.#{FIRST_CONTROL_PLANE_HOST + i}"
    end
  end

  (0...SHAPE[:workers]).each do |i|
    config.vm.define "worker#{i + 1}" do |node|
      node.vm.hostname = "worker#{i + 1}"
      node.vm.network "private_network", ip: "#{SUBNET}.#{FIRST_WORKER_HOST + i}"
    end
  end

  if SHAPE[:nfs_server]
    config.vm.define "nfs1" do |node|
      node.vm.hostname = "nfs1"
      node.vm.network "private_network", ip: "#{SUBNET}.#{NFS_SERVER_HOST}"

      # It only serves the export; it runs no part of the cluster.
      node.vm.provider "virtualbox" do |vb|
        vb.cpus = 1
        vb.memory = 1024
      end
    end
  end
end
